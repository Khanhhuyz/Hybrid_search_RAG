# GRAG Backend Environment Configuration
# Copy this file to .env and adjust values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="GRAG - GraphRAG System"
DEBUG=false

# ─── Ollama (local models) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2
# EMBEDDING_DIMENSION must match your embedding model:
#   nomic-embed-text → 768
#   mxbai-embed-large → 1024
EMBEDDING_DIMENSION=768

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=grag_chunks

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval ────────────────────────────────────────────────────────────────
TOP_K_SEMANTIC=5
TOP_K_GRAPH=5
SIMILARITY_THRESHOLD=0.6

# ─── Generation ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
