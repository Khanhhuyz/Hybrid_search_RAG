# GRAG Backend Environment Configuration
# Copy this file to .env and adjust values

# ─── Application ─────────────────────────────────────────────────────────────
APP_NAME="GRAG - GraphRAG System"
DEBUG=false

# ─── Ollama (local models) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
LLM_MODEL=llama3.2
# EMBEDDING_DIMENSION must match your embedding model:
#   nomic-embed-text → 768
#   mxbai-embed-large → 1024
EMBEDDING_DIMENSION=768

# ─── Qdrant Vector Database ───────────────────────────────────────────────────
QDRANT_COLLECTION=grag_chunks
# Optional: Set QDRANT_URL and QDRANT_API_KEY for Qdrant Cloud connection
# QDRANT_URL=https://your-cluster-id.cloud.qdrant.io
# QDRANT_API_KEY=your-api-key

# ─── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Retrieval ────────────────────────────────────────────────────────────────
TOP_K_SEMANTIC=5
TOP_K_GRAPH=5
SIMILARITY_THRESHOLD=0.6

# ─── Generation ───────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
# Advanced retrieval (set RERANKER_MODEL to a locally available multilingual
# sentence-transformers CrossEncoder; empty uses the deterministic fallback)
RERANKER_ENABLED=true
# Point this at a locally cached CrossEncoder to avoid runtime downloads.
RERANKER_MODEL=
RERANKER_OLLAMA_FALLBACK=true
RERANK_MIN_SCORE=0.12
RETRIEVAL_MIN_EVIDENCE_SCORE=0.18
NO_ANSWER_CONFIDENCE_THRESHOLD=0.35

# Optional scanned-PDF OCR. Install pytesseract/Pillow and the local Tesseract
# vie+eng language packs; native PDF extraction remains the fallback.
OCR_ENABLED=true
OCR_MIN_PAGE_CHARS=40

# ─── Agent Workspace ─────────────────────────────────────────────────────────
AGENT_ENABLED=true
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT=180
OUTPUT_DIR=data/outputs
MAX_OUTPUT_FILE_SIZE_MB=50
# External side effects stay disabled until a provider is explicitly configured.
ACTIONS_ENABLED=false
ACTION_REQUIRE_APPROVAL=true
